# Copy to .env.local and fill in. .env.local is gitignored; never commit a real key.
# Create a key at https://console.anthropic.com -> Settings -> API keys

# Switches the planner and worker agents onto the Claude API.
# Without it, a deterministic local reasoner stands in and the board still runs.
ANTHROPIC_API_KEY=

# Optional. Model both agent roles use.
# AGENTIC_MODEL=claude-opus-5

# Optional. Where the persisted board lives.
# AGENTIC_DATA_DIR=.data
